# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and configuration files
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.swift text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Binary assets
*.png binary
*.icns binary
*.dmg binary
